model User {
  id    Int    @id @default(autoincrement())
  email String @unique
  posts Post[] // Relationship field
}

model Post {
  id        Int    @id @default(autoincrement())
  title     String
  authorId  Int    // Foreign key
  author    User   @relation(fields: [authorId], references: [id])
}

model Product {
  id    Int    @id @default(autoincrement())
  carts Cart[] // Implicit M:N
}

model Cart {
  id       Int       @id @default(autoincrement())
  products Product[]
}